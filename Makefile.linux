# Portable build of the Source/ firmware (STM32F746, Cortex-M7).
#
# build.sh is the Windows build: fixed CubeIDE toolchain path, fixed repo
# path, one gcc invocation for everything. This makefile builds the same
# source set with the same flags, but takes the toolchain from PATH (or
# PREFIX=) and rebuilds only what changed.
#
#   make -f Makefile.linux                # -Os (default: the DSP needs the speed)
#   make -f Makefile.linux OPT=-O0        # debug
#   make -f Makefile.linux PREFIX=/opt/arm-gnu/bin/arm-none-eabi-
#   make -f Makefile.linux -j8
#
# Outputs build/PSDR_F7.elf, .hex, .bin (same names as build.sh).

TARGET  = PSDR_F7
BUILD   = build
PREFIX ?= arm-none-eabi-
CC      = $(PREFIX)gcc
CP      = $(PREFIX)objcopy
SZ      = $(PREFIX)size

CPU  = -mcpu=cortex-m7 -mthumb -mfpu=fpv5-sp-d16 -mfloat-abi=hard
DEFS = -DSTM32F746xx -DUSE_HAL_DRIVER -DHSE_VALUE=26000000 -DDEBUG -DTRACE \
       -DOS_USE_TRACE_SEMIHOSTING_DEBUG -DOS_INCLUDE_STARTUP_INIT_MULTIPLE_RAM_SECTIONS \
       -DARM_MATH_CM7 -D__FPU_PRESENT=1
INCS = -ISource/include -ISource/system/include -ISource/system/include/cmsis \
       -ISource/system/include/stm32f7-hal -ISource/usb

OPT ?= -Os

CFLAGS  = $(CPU) $(DEFS) $(INCS) $(OPT) -g -std=gnu11 -Wno-unused -fcommon \
          -ffunction-sections -fdata-sections
LDFLAGS = $(CPU) -T mem.ld -T libs.ld -T sections.ld -L Source/ldscripts -nostartfiles \
          -Wl,--gc-sections -Wl,-Map,$(BUILD)/$(TARGET).map --specs=nano.specs
LIBS = -lm

# Same source list as build.sh: everything under these four trees, minus the
# HAL MSP template (it redefines the HAL_MspInit/HAL_MspDeInit symbols that
# src/stm32f7xx_hal_msp.c provides) and the _ref_* CubeMX reference files.
C_SRCS = $(shell find Source/src Source/system/src Source/DSP_Lib/Source Source/usb \
           -name '*.c' ! -name '*_template.c' ! -name '*_ref_*')
# arm_bitreversal_32 is hand-written assembly; build.sh only globs *.c.
ASM_SRCS = $(wildcard Source/DSP_Lib/Source/TransformFunctions/*.S)

OBJDIR = $(BUILD)/obj
OBJS   = $(addprefix $(OBJDIR)/,$(C_SRCS:.c=.o)) $(addprefix $(OBJDIR)/,$(ASM_SRCS:.S=.o))

all: $(BUILD)/$(TARGET).elf $(BUILD)/$(TARGET).hex $(BUILD)/$(TARGET).bin

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/%.o: %.S
	@mkdir -p $(dir $@)
	$(CC) $(CPU) -c $< -o $@

$(BUILD)/$(TARGET).elf: $(OBJS)
	@mkdir -p $(BUILD)
	$(CC) $(OBJS) $(LDFLAGS) $(LIBS) -o $@

$(BUILD)/$(TARGET).hex: $(BUILD)/$(TARGET).elf
	$(CP) -O ihex $< $@
	$(SZ) $<

$(BUILD)/$(TARGET).bin: $(BUILD)/$(TARGET).elf
	$(CP) -O binary $< $@

clean:
	rm -rf $(BUILD)

.PHONY: all clean
